# APLTE Dashboard Configuration
# Copy to .env and customize as needed.

# Dashboard server port (default: 8787)
# DASHBOARD_PORT=8787

# Path overrides (defaults are relative to repo root)
# CV_LIBRARY_DIR=/path/to/cv-library
# EASY_APPLY_DIR=/path/to/data/out/easy-apply
# DATA_DIR=/path/to/data
# MEMORY_DIR=/path/to/.memory
# SCAN_FILE=/path/to/data/scan.json
# PLAN_FILE=/path/to/data/pending-plan.json
# APPLIED_FILE=/path/to/data/applied.jsonl
# AUDIT_FILE=/path/to/data/audit.jsonl
# LIVE_LOG=/path/to/.memory/live.log
# BROWSER_EVENTS=/path/to/.memory/browser-events.jsonl
# REASONING_LOG=/path/to/.memory/reasoning.jsonl
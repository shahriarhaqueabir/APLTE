# ---------------------------------------------------------------------------
# jobbot — never publish personal data
# ---------------------------------------------------------------------------

# Dependencies / toolchain (not needed to run from source)
node_modules/
bin/
browser-profile/
*.log

# Personal documents — CVs, cover letters, application PDFs/DOCX/PNG exports
CVs/
cv-library/
CV_LIBRARY.md

# Project documentation is kept local (not published), except a small
# public-facing set that is explicitly tracked below.
docs/research/
docs/superpowers/
docs/DASHBOARD_REVIEW_REPORT.md
docs/BOM.md
docs/playbook*
plans/

# Local environment notes and agent instructions (machine-specific)
AGENTS.md
ENVIRONMENT-HARDENING.md
environment.lock.json

# Personal data (profile, answers, application log, audit trail, rendered output)
data/profile.json
data/answers.json
data/audit.jsonl
data/applied.jsonl
data/scan.json
data/pending-plan.json
data/pending-scan.json
data/out/

# Agent memory — contains references to personal data
.memory/

# Credentials / secrets (defensive; none are currently in the repo)
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json
cookies*.json

# Scaffolding store (versions may contain personal config)
data/scaffolding/
data/runner.json
data/queue/
data/answer-cache.json

# Generated / personal-data artifacts (never commit)
data/cv-sections.json
data/dashboard-api-data.json
dashboard-*.js
dashboard-*.html
dashboard-*.css
check-dashboard.mjs

# Scratch / debug scripts (never commit)
tools/check*.mjs
tools/debug-*.mjs
tools/find*.mjs
tools/get*.mjs
tools/goto.mjs
tools/inspect*.mjs
tools/launch-chrome.mjs
tools/patch*.mjs
tools/testapprove.mjs
tools/testbtn*.mjs
tools/updatemanifest.mjs
tools/browser-agent.mjs

# Private modules (secrets, adapters, config - never committed)
private/
private/secrets/
private/adapters/
private/config/
